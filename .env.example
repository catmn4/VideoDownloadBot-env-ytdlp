# Required
TOKEN=123456789:replace_with_your_bot_token

# Optional Telegram Bot API settings
# BOT_API_URL=https://api.telegram.org

# Optional storage and administration
# DATA_DIR=./data
# ADMIN_ID=123456789
# STORAGE_CHAT=123456789
# MAX_DOWNLOADS=8

# Optional authenticated yt-dlp session
# COOKIES=/cookies.txt

# Optional networking and deployment settings
# YTDLP_PATH=/home/container/bin/yt-dlp
# EGRESS_DENY=203.0.113.10/32
# WARP_PROXY=127.0.0.1:25345
# SHARED_DIR=/scratch
# STATS_PORT=8080

# Optional promotion settings
# PROMO_TOKEN=
# PROMO_URL=https://lumen.borodutch.com/go/campaigns.json
